# ─────────────────────────────────────────────────────────────
#  Zoha v2 configuration   (everything here is also editable in the app: Settings)
# ─────────────────────────────────────────────────────────────

# You
USER_NAME=
HOME_CITY=
ASSISTANT_NAME=Zoha

# Brain: "gemini" (best quality, free tier has limits) · "local" (Ollama on your GPU, unlimited, offline)
#        · "openai" (any OpenAI-compatible endpoint)
LLM_PROVIDER=gemini
# When Gemini's limit runs out / it's down / you're offline → continue on the local model automatically
LLM_FALLBACK=none
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3.5:4b
LOCAL_LLM_CTX=12288          # context window for the local model (tools + browser pages need ~12k)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
#   OpenRouter free models:   LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<model>:free
#   Ollama on your GPU:       LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=qwen3:8b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/auto
CONVERSATION_HISTORY_LIMIT=12
EXTRA_INSTRUCTIONS=

# Wake word
WAKE_WORD=zoha
WAKE_ALIASES=jarvis
FOLLOW_UP_SECONDS=8          # after Zoha answers, keep listening this long without the wake word
BARGE_IN=true                # say "Zoha" or "stop" while she's talking to interrupt

# Microphone
AUDIO_DEVICE_INDEX=-1        # -1 = system default (see: python diagnostics.py)
MIC_GAIN_BOOST=1.5
VAD_THRESHOLD=0.5            # Silero voice detection: higher = stricter
VAD_END_SILENCE_MS=700       # pause length that ends your sentence
VAD_PHRASE_TIME_LIMIT=25
VAD_TIMEOUT=6                # after "Zoha" / Talk, how long to wait for you to start

# Speech recognition
WHISPER_MODEL=auto           # auto → large-v3-turbo on GPU, small.en on CPU
WHISPER_DEVICE=auto          # auto | cuda | cpu
WHISPER_COMPUTE_TYPE=auto
WAKE_MODEL=auto              # auto → tiny.en for the always-on wake pass on CPU
STT_LANGUAGE=en              # en | auto (Hindi / Marathi / Hinglish need a multilingual model)

# Voice: kokoro = local neural voice (offline, unlimited) | edge = Microsoft online voices
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.05
EDGE_TTS_VOICE=en-US-JennyNeural
TTS_RATE=+6%
TTS_PITCH=+0Hz

# Zoha's browser (Playwright). auto = Edge → Chrome → bundled Chromium. Profile lives in data/browser-profile
BROWSER_CHANNEL=auto

# Website / CMS plugin (optional). Lets Zoha read and change YOUR site through a small Agent API
# (docs/site-agent-api.md). Leave empty to turn it off. Every change is read out and needs your "yes".
SITE_NAME=
SITE_API_URL=
SITE_API_KEY=
